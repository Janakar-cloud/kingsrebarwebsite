{
  "name": "kingsrebarwebsite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/support/register.mjs --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:production": "node scripts/e2e.mjs production",
    "test:e2e:review": "node scripts/e2e.mjs review",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
