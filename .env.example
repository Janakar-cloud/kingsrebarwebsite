# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings. Never commit real values.

# Production origin, e.g. https://www.example.com (no trailing path).
# Used for canonical URLs, Open Graph URLs, sitemap.xml and robots.txt.
SITE_URL=

# Set to "true" only on the live production deployment, once all content is
# approved. Anything else (or a missing SITE_URL) serves robots "noindex".
ALLOW_INDEXING=

# Server-only. Enquiry form destination: an HTTPS endpoint that accepts a JSON
# POST and returns 2xx on success (e.g. a Formspree form endpoint, a Zapier/
# Make/n8n webhook, or the client's own API).
ENQUIRY_WEBHOOK_URL=

# Server-only, optional. Sent as "Authorization: Bearer <token>" to the webhook.
ENQUIRY_WEBHOOK_TOKEN=

# Optional. "true" shows dashed "Content needed" boxes; "false" hides them.
# Defaults to shown in development and hidden in production builds.
# Use "true" on a review deployment so the client can see what is missing.
SHOW_CONTENT_PLACEHOLDERS=

# Development only (ignored in production): "success" or "failure" to preview
# the form's outcome states without a real destination.
ENQUIRY_DEV_SIMULATE=
