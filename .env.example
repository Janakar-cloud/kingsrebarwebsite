# Copy to .env.local for local development, or set these in Vercel → Settings →
# Environment Variables. Never commit real values.

# Production origin (no trailing path). Used for canonical URLs, Open Graph URLs,
# sitemap.xml and robots.txt. For the live site: https://www.kingsrebar.com
# For a Vercel UAT preview you can leave this empty; the deployment URL is used.
SITE_URL=

# Set to "true" only on the live production deployment, once all content is
# approved. Leave unset on Vercel UAT so the demo stays out of search.
ALLOW_INDEXING=

# --- Enquiry delivery (Outlook / Microsoft 365) -----------------------------
# Enquiries are emailed to info@kingsrebar.com from the same mailbox, with the
# visitor's address as Reply-To. Pick ONE of the two Outlook options.

# Mailbox used as both sender and (by default) recipient.
OUTLOOK_MAILBOX=info@kingsrebar.com
# Optional. Overrides the recipient; defaults to info@kingsrebar.com.
ENQUIRY_TO_EMAIL=info@kingsrebar.com

# Option A (recommended on Vercel): Microsoft Graph app in Azure AD, with
# application permission Mail.Send and admin consent. The app sends as the mailbox.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Option B (typical for local UAT): SMTP AUTH on the Outlook mailbox.
# Use an app password if the account has MFA. Authenticated SMTP must be
# enabled for the mailbox. Serverless hosts (Vercel) prefer Option A.
OUTLOOK_SMTP_PASSWORD=
# Optional. Defaults to OUTLOOK_MAILBOX / info@kingsrebar.com
OUTLOOK_SMTP_USER=
# Optional. Defaults to smtp.office365.com:587
OUTLOOK_SMTP_HOST=
OUTLOOK_SMTP_PORT=

# Fallback: Resend, used only when neither Outlook option is fully set.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Last resort: an HTTPS endpoint that accepts a JSON POST and returns 2xx.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# Optional. "true" shows dashed "Content needed" boxes; "false" hides them.
# Defaults to shown in development and hidden in production builds.
SHOW_CONTENT_PLACEHOLDERS=

# Development only (ignored in production): "success" or "failure" to preview
# the form's outcome states without a real destination.
ENQUIRY_DEV_SIMULATE=
